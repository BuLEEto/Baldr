	// notify the source-side available actions
	source_actions: proc "c" (data: rawptr, p: Proxy, source_actions: Wl_Data_Device_Manager_Dnd_Action),
	// notify the selected action
	action: proc "c" (data: rawptr, p: Proxy, dnd_action: Wl_Data_Device_Manager_Dnd_Action),
}

wl_data_offer_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Data_Offer_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_data_offer_listener_noop :: proc "contextless" () -> Wl_Data_Offer_Listener {
	return {
		offer = proc "c" (data: rawptr, p: Proxy, mime_type: cstring) {},
		source_actions = proc "c" (data: rawptr, p: Proxy, source_actions: Wl_Data_Device_Manager_Dnd_Action) {},
		action = proc "c" (data: rawptr, p: Proxy, dnd_action: Wl_Data_Device_Manager_Dnd_Action) {},
	}
}

// ----------------------------------------------------------------------------
// wl_data_source
// offer to transfer data

WL_DATA_SOURCE_VERSION :: 3
wl_data_source_interface: Interface

Wl_Data_Source_Error :: enum u32 {
	Invalid_Action_Mask = 0, // action mask contains invalid values
	Invalid_Source = 1, // source doesn't accept this request
}

// offer — add an offered mime type
wl_data_source_offer :: proc "contextless" (p: Proxy, mime_type: cstring) {
	args := [1]Argument{{s = mime_type}}
	marshal(p, 0, nil, 0, 0, &args[0])
}

// destroy — destroy the data source [destructor]
wl_data_source_destroy :: proc "contextless" (p: Proxy) {
	marshal(p, 1, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// set_actions — set the available drag-and-drop actions (since v3)
wl_data_source_set_actions :: proc "contextless" (p: Proxy, dnd_actions: Wl_Data_Device_Manager_Dnd_Action) {
	if proxy_version(p) < 3 do return
	args := [1]Argument{{u = u32(dnd_actions)}}
	marshal(p, 2, nil, 0, 0, &args[0])
}

// Wl_Data_Source_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_data_source_listener_noop().
Wl_Data_Source_Listener :: struct {
	// a target accepts an offered mime type
	target: proc "c" (data: rawptr, p: Proxy, mime_type: cstring),
	// send the data
	send: proc "c" (data: rawptr, p: Proxy, mime_type: cstring, fd: i32),
	// selection was cancelled
	cancelled: proc "c" (data: rawptr, p: Proxy),
	// the drag-and-drop operation physically finished
	dnd_drop_performed: proc "c" (data: rawptr, p: Proxy),
	// the drag-and-drop operation concluded
	dnd_finished: proc "c" (data: rawptr, p: Proxy),
	// notify the selected action
	action: proc "c" (data: rawptr, p: Proxy, dnd_action: Wl_Data_Device_Manager_Dnd_Action),
}

wl_data_source_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Data_Source_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_data_source_listener_noop :: proc "contextless" () -> Wl_Data_Source_Listener {
	return {
		target = proc "c" (data: rawptr, p: Proxy, mime_type: cstring) {},
		send = proc "c" (data: rawptr, p: Proxy, mime_type: cstring, fd: i32) {},
		cancelled = proc "c" (data: rawptr, p: Proxy) {},
		dnd_drop_performed = proc "c" (data: rawptr, p: Proxy) {},
		dnd_finished = proc "c" (data: rawptr, p: Proxy) {},
		action = proc "c" (data: rawptr, p: Proxy, dnd_action: Wl_Data_Device_Manager_Dnd_Action) {},
	}
}

// ----------------------------------------------------------------------------
// wl_data_device
// data transfer device

WL_DATA_DEVICE_VERSION :: 3
wl_data_device_interface: Interface

Wl_Data_Device_Error :: enum u32 {
	Role = 0, // given wl_surface has another role
	Used_Source = 1, // source has already been used
}

// start_drag — start drag-and-drop operation
wl_data_device_start_drag :: proc "contextless" (p: Proxy, source: Proxy, origin: Proxy, icon: Proxy, serial: u32) {
	args := [4]Argument{{o = rawptr(source)}, {o = rawptr(origin)}, {o = rawptr(icon)}, {u = serial}}
	marshal(p, 0, nil, 0, 0, &args[0])
}

// set_selection — copy data to the selection
wl_data_device_set_selection :: proc "contextless" (p: Proxy, source: Proxy, serial: u32) {
	args := [2]Argument{{o = rawptr(source)}, {u = serial}}
	marshal(p, 1, nil, 0, 0, &args[0])
}

// release — destroy data device (since v2) [destructor]
wl_data_device_release :: proc "contextless" (p: Proxy) {
	if proxy_version(p) < 2 do return
	marshal(p, 2, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// Wl_Data_Device_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_data_device_listener_noop().
Wl_Data_Device_Listener :: struct {
	// introduce a new wl_data_offer
	data_offer: proc "c" (data: rawptr, p: Proxy, id: Proxy),
	// initiate drag-and-drop session
	enter: proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy, x: Fixed, y: Fixed, id: Proxy),
	// end drag-and-drop session
	leave: proc "c" (data: rawptr, p: Proxy),
	// drag-and-drop session motion
	motion: proc "c" (data: rawptr, p: Proxy, time: u32, x: Fixed, y: Fixed),
	// end drag-and-drop session successfully
	drop: proc "c" (data: rawptr, p: Proxy),
	// advertise new selection
	selection: proc "c" (data: rawptr, p: Proxy, id: Proxy),
}

wl_data_device_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Data_Device_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_data_device_listener_noop :: proc "contextless" () -> Wl_Data_Device_Listener {
	return {
		data_offer = proc "c" (data: rawptr, p: Proxy, id: Proxy) {},
		enter = proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy, x: Fixed, y: Fixed, id: Proxy) {},
		leave = proc "c" (data: rawptr, p: Proxy) {},
		motion = proc "c" (data: rawptr, p: Proxy, time: u32, x: Fixed, y: Fixed) {},
		drop = proc "c" (data: rawptr, p: Proxy) {},
		selection = proc "c" (data: rawptr, p: Proxy, id: Proxy) {},
	}
}

// ----------------------------------------------------------------------------
// wl_data_device_manager
