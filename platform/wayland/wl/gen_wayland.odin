WL_DATA_DEVICE_MANAGER_VERSION :: 3
wl_data_device_manager_interface: Interface

// drag and drop actions
Wl_Data_Device_Manager_Dnd_Action :: distinct u32
WL_DATA_DEVICE_MANAGER_DND_ACTION_NONE :: Wl_Data_Device_Manager_Dnd_Action(0) // no action
WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY :: Wl_Data_Device_Manager_Dnd_Action(1) // copy action
WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE :: Wl_Data_Device_Manager_Dnd_Action(2) // move action
WL_DATA_DEVICE_MANAGER_DND_ACTION_ASK :: Wl_Data_Device_Manager_Dnd_Action(4) // ask action

// create_data_source — create a new data source
wl_data_device_manager_create_data_source :: proc "contextless" (p: Proxy) -> Proxy {
	args := [1]Argument{{o = nil}}
	return marshal(p, 0, &wl_data_source_interface, proxy_version(p), 0, &args[0])
}

// get_data_device — create a new data device
wl_data_device_manager_get_data_device :: proc "contextless" (p: Proxy, seat: Proxy) -> Proxy {
