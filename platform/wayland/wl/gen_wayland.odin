}

// ----------------------------------------------------------------------------
// wl_shell
// create desktop-style surfaces

WL_SHELL_VERSION :: 1
wl_shell_interface: Interface

Wl_Shell_Error :: enum u32 {
	Role = 0, // given wl_surface has another role
}

// get_shell_surface — create a shell surface from a surface
wl_shell_get_shell_surface :: proc "contextless" (p: Proxy, surface: Proxy) -> Proxy {
	args := [2]Argument{{o = nil}, {o = rawptr(surface)}}
	return marshal(p, 0, &wl_shell_surface_interface, proxy_version(p), 0, &args[0])
}

// ----------------------------------------------------------------------------
// wl_shell_surface
// desktop-style metadata interface

WL_SHELL_SURFACE_VERSION :: 1
wl_shell_surface_interface: Interface

// edge values for resizing
Wl_Shell_Surface_Resize :: distinct u32
WL_SHELL_SURFACE_RESIZE_NONE :: Wl_Shell_Surface_Resize(0) // no edge
WL_SHELL_SURFACE_RESIZE_TOP :: Wl_Shell_Surface_Resize(1) // top edge
WL_SHELL_SURFACE_RESIZE_BOTTOM :: Wl_Shell_Surface_Resize(2) // bottom edge
WL_SHELL_SURFACE_RESIZE_LEFT :: Wl_Shell_Surface_Resize(4) // left edge
WL_SHELL_SURFACE_RESIZE_TOP_LEFT :: Wl_Shell_Surface_Resize(5) // top and left edges
WL_SHELL_SURFACE_RESIZE_BOTTOM_LEFT :: Wl_Shell_Surface_Resize(6) // bottom and left edges
WL_SHELL_SURFACE_RESIZE_RIGHT :: Wl_Shell_Surface_Resize(8) // right edge
WL_SHELL_SURFACE_RESIZE_TOP_RIGHT :: Wl_Shell_Surface_Resize(9) // top and right edges
WL_SHELL_SURFACE_RESIZE_BOTTOM_RIGHT :: Wl_Shell_Surface_Resize(10) // bottom and right edges

// details of transient behaviour
Wl_Shell_Surface_Transient :: distinct u32
WL_SHELL_SURFACE_TRANSIENT_INACTIVE :: Wl_Shell_Surface_Transient(1) // do not set keyboard focus

// different method to set the surface fullscreen
Wl_Shell_Surface_Fullscreen_Method :: enum u32 {
	Default = 0, // no preference, apply default policy
	Scale = 1, // scale, preserve the surface's aspect ratio and center on output
	Driver = 2, // switch output mode to the smallest mode that can fit the surface, add black borders to compensate size mismatch
	Fill = 3, // no upscaling, center on output and add black borders to compensate size mismatch
}

// pong — respond to a ping event
wl_shell_surface_pong :: proc "contextless" (p: Proxy, serial: u32) {
	args := [1]Argument{{u = serial}}
	marshal(p, 0, nil, 0, 0, &args[0])
}

// move — start an interactive move
wl_shell_surface_move :: proc "contextless" (p: Proxy, seat: Proxy, serial: u32) {
	args := [2]Argument{{o = rawptr(seat)}, {u = serial}}
	marshal(p, 1, nil, 0, 0, &args[0])
}

// resize — start an interactive resize
wl_shell_surface_resize :: proc "contextless" (p: Proxy, seat: Proxy, serial: u32, edges: Wl_Shell_Surface_Resize) {
	args := [3]Argument{{o = rawptr(seat)}, {u = serial}, {u = u32(edges)}}
	marshal(p, 2, nil, 0, 0, &args[0])
}

// set_toplevel — make the surface a toplevel surface
wl_shell_surface_set_toplevel :: proc "contextless" (p: Proxy) {
	marshal(p, 3, nil, 0, 0, nil)
}

// set_transient — make the surface a transient surface
wl_shell_surface_set_transient :: proc "contextless" (p: Proxy, parent: Proxy, x: i32, y: i32, flags: Wl_Shell_Surface_Transient) {
	args := [4]Argument{{o = rawptr(parent)}, {i = x}, {i = y}, {u = u32(flags)}}
	marshal(p, 4, nil, 0, 0, &args[0])
}

// set_fullscreen — make the surface a fullscreen surface
wl_shell_surface_set_fullscreen :: proc "contextless" (p: Proxy, method: Wl_Shell_Surface_Fullscreen_Method, framerate: u32, output: Proxy) {
	args := [3]Argument{{u = u32(method)}, {u = framerate}, {o = rawptr(output)}}
	marshal(p, 5, nil, 0, 0, &args[0])
}

// set_popup — make the surface a popup surface
wl_shell_surface_set_popup :: proc "contextless" (p: Proxy, seat: Proxy, serial: u32, parent: Proxy, x: i32, y: i32, flags: Wl_Shell_Surface_Transient) {
	args := [6]Argument{{o = rawptr(seat)}, {u = serial}, {o = rawptr(parent)}, {i = x}, {i = y}, {u = u32(flags)}}
	marshal(p, 6, nil, 0, 0, &args[0])
}

// set_maximized — make the surface a maximized surface
wl_shell_surface_set_maximized :: proc "contextless" (p: Proxy, output: Proxy) {
	args := [1]Argument{{o = rawptr(output)}}
	marshal(p, 7, nil, 0, 0, &args[0])
}

// set_title — set surface title
wl_shell_surface_set_title :: proc "contextless" (p: Proxy, title: cstring) {
	args := [1]Argument{{s = title}}
	marshal(p, 8, nil, 0, 0, &args[0])
}

// set_class — set surface class
wl_shell_surface_set_class :: proc "contextless" (p: Proxy, class_: cstring) {
	args := [1]Argument{{s = class_}}
	marshal(p, 9, nil, 0, 0, &args[0])
}

// Wl_Shell_Surface_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_shell_surface_listener_noop().
Wl_Shell_Surface_Listener :: struct {
	// ping client
	ping: proc "c" (data: rawptr, p: Proxy, serial: u32),
	// suggest resize
	configure: proc "c" (data: rawptr, p: Proxy, edges: Wl_Shell_Surface_Resize, width: i32, height: i32),
	// popup interaction is done
	popup_done: proc "c" (data: rawptr, p: Proxy),
}

wl_shell_surface_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Shell_Surface_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_shell_surface_listener_noop :: proc "contextless" () -> Wl_Shell_Surface_Listener {
	return {
		ping = proc "c" (data: rawptr, p: Proxy, serial: u32) {},
		configure = proc "c" (data: rawptr, p: Proxy, edges: Wl_Shell_Surface_Resize, width: i32, height: i32) {},
		popup_done = proc "c" (data: rawptr, p: Proxy) {},
	}
}

// ----------------------------------------------------------------------------
// wl_surface
// an onscreen surface

WL_SURFACE_VERSION :: 6
wl_surface_interface: Interface

// wl_surface error values
Wl_Surface_Error :: enum u32 {
	Invalid_Scale = 0, // buffer scale value is invalid
	Invalid_Transform = 1, // buffer transform value is invalid
	Invalid_Size = 2, // buffer size is invalid
	Invalid_Offset = 3, // buffer offset is invalid
	Defunct_Role_Object = 4, // surface was destroyed before its role object
}

// destroy — delete surface [destructor]
wl_surface_destroy :: proc "contextless" (p: Proxy) {
	marshal(p, 0, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// attach — set the surface contents
wl_surface_attach :: proc "contextless" (p: Proxy, buffer: Proxy, x: i32, y: i32) {
	args := [3]Argument{{o = rawptr(buffer)}, {i = x}, {i = y}}
	marshal(p, 1, nil, 0, 0, &args[0])
}

// damage — mark part of the surface damaged
wl_surface_damage :: proc "contextless" (p: Proxy, x: i32, y: i32, width: i32, height: i32) {
	args := [4]Argument{{i = x}, {i = y}, {i = width}, {i = height}}
	marshal(p, 2, nil, 0, 0, &args[0])
}

// frame — request a frame throttling hint
wl_surface_frame :: proc "contextless" (p: Proxy) -> Proxy {
	args := [1]Argument{{o = nil}}
	return marshal(p, 3, &wl_callback_interface, proxy_version(p), 0, &args[0])
}

// set_opaque_region — set opaque region
wl_surface_set_opaque_region :: proc "contextless" (p: Proxy, region: Proxy) {
	args := [1]Argument{{o = rawptr(region)}}
	marshal(p, 4, nil, 0, 0, &args[0])
}

// set_input_region — set input region
wl_surface_set_input_region :: proc "contextless" (p: Proxy, region: Proxy) {
	args := [1]Argument{{o = rawptr(region)}}
	marshal(p, 5, nil, 0, 0, &args[0])
}

// commit — commit pending surface state
wl_surface_commit :: proc "contextless" (p: Proxy) {
	marshal(p, 6, nil, 0, 0, nil)
}

// set_buffer_transform — sets the buffer transformation (since v2)
wl_surface_set_buffer_transform :: proc "contextless" (p: Proxy, transform: Wl_Output_Transform) {
	if proxy_version(p) < 2 do return
	args := [1]Argument{{i = i32(transform)}}
	marshal(p, 7, nil, 0, 0, &args[0])
}

// set_buffer_scale — sets the buffer scaling factor (since v3)
wl_surface_set_buffer_scale :: proc "contextless" (p: Proxy, scale: i32) {
	if proxy_version(p) < 3 do return
	args := [1]Argument{{i = scale}}
	marshal(p, 8, nil, 0, 0, &args[0])
}

// damage_buffer — mark part of the surface damaged using buffer coordinates (since v4)
wl_surface_damage_buffer :: proc "contextless" (p: Proxy, x: i32, y: i32, width: i32, height: i32) {
	if proxy_version(p) < 4 do return
	args := [4]Argument{{i = x}, {i = y}, {i = width}, {i = height}}
	marshal(p, 9, nil, 0, 0, &args[0])
}

// offset — set the surface contents offset (since v5)
wl_surface_offset :: proc "contextless" (p: Proxy, x: i32, y: i32) {
	if proxy_version(p) < 5 do return
	args := [2]Argument{{i = x}, {i = y}}
	marshal(p, 10, nil, 0, 0, &args[0])
}

// Wl_Surface_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_surface_listener_noop().
Wl_Surface_Listener :: struct {
	// surface enters an output
	enter: proc "c" (data: rawptr, p: Proxy, output: Proxy),
	// surface leaves an output
	leave: proc "c" (data: rawptr, p: Proxy, output: Proxy),
	// preferred buffer scale for the surface
	preferred_buffer_scale: proc "c" (data: rawptr, p: Proxy, factor: i32),
	// preferred buffer transform for the surface
	preferred_buffer_transform: proc "c" (data: rawptr, p: Proxy, transform: Wl_Output_Transform),
}

wl_surface_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Surface_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_surface_listener_noop :: proc "contextless" () -> Wl_Surface_Listener {
	return {
		enter = proc "c" (data: rawptr, p: Proxy, output: Proxy) {},
		leave = proc "c" (data: rawptr, p: Proxy, output: Proxy) {},
		preferred_buffer_scale = proc "c" (data: rawptr, p: Proxy, factor: i32) {},
		preferred_buffer_transform = proc "c" (data: rawptr, p: Proxy, transform: Wl_Output_Transform) {},
	}
}

// ----------------------------------------------------------------------------
// wl_seat
// group of input devices

WL_SEAT_VERSION :: 9
wl_seat_interface: Interface

// seat capability bitmask
Wl_Seat_Capability :: distinct u32
WL_SEAT_CAPABILITY_POINTER :: Wl_Seat_Capability(1) // the seat has pointer devices
WL_SEAT_CAPABILITY_KEYBOARD :: Wl_Seat_Capability(2) // the seat has one or more keyboards
WL_SEAT_CAPABILITY_TOUCH :: Wl_Seat_Capability(4) // the seat has touch devices

// wl_seat error values
Wl_Seat_Error :: enum u32 {
	Missing_Capability = 0, // get_pointer, get_keyboard or get_touch called on seat without the matching capability
}

// get_pointer — return pointer object
wl_seat_get_pointer :: proc "contextless" (p: Proxy) -> Proxy {
	args := [1]Argument{{o = nil}}
	return marshal(p, 0, &wl_pointer_interface, proxy_version(p), 0, &args[0])
}

// get_keyboard — return keyboard object
wl_seat_get_keyboard :: proc "contextless" (p: Proxy) -> Proxy {
	args := [1]Argument{{o = nil}}
	return marshal(p, 1, &wl_keyboard_interface, proxy_version(p), 0, &args[0])
}

// get_touch — return touch object
wl_seat_get_touch :: proc "contextless" (p: Proxy) -> Proxy {
	args := [1]Argument{{o = nil}}
	return marshal(p, 2, &wl_touch_interface, proxy_version(p), 0, &args[0])
}

// release — release the seat object (since v5) [destructor]
wl_seat_release :: proc "contextless" (p: Proxy) {
	if proxy_version(p) < 5 do return
	marshal(p, 3, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// Wl_Seat_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_seat_listener_noop().
Wl_Seat_Listener :: struct {
	// seat capabilities changed
	capabilities: proc "c" (data: rawptr, p: Proxy, capabilities: Wl_Seat_Capability),
	// unique identifier for this seat
	name: proc "c" (data: rawptr, p: Proxy, name: cstring),
}

wl_seat_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Seat_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_seat_listener_noop :: proc "contextless" () -> Wl_Seat_Listener {
	return {
		capabilities = proc "c" (data: rawptr, p: Proxy, capabilities: Wl_Seat_Capability) {},
		name = proc "c" (data: rawptr, p: Proxy, name: cstring) {},
	}
}

// ----------------------------------------------------------------------------
// wl_pointer
// pointer input device

WL_POINTER_VERSION :: 9
wl_pointer_interface: Interface

Wl_Pointer_Error :: enum u32 {
	Role = 0, // given wl_surface has another role
}

// physical button state
Wl_Pointer_Button_State :: enum u32 {
	Released = 0, // the button is not pressed
	Pressed = 1, // the button is pressed
}

// axis types
Wl_Pointer_Axis :: enum u32 {
	Vertical_Scroll = 0, // vertical axis
	Horizontal_Scroll = 1, // horizontal axis
}

// axis source types
Wl_Pointer_Axis_Source :: enum u32 {
	Wheel = 0, // a physical wheel rotation
	Finger = 1, // finger on a touch surface
	Continuous = 2, // continuous coordinate space
	Wheel_Tilt = 3, // a physical wheel tilt
}

// axis relative direction
Wl_Pointer_Axis_Relative_Direction :: enum u32 {
	Identical = 0, // physical motion matches axis direction
	Inverted = 1, // physical motion is the inverse of the axis direction
}

// set_cursor — set the pointer surface
wl_pointer_set_cursor :: proc "contextless" (p: Proxy, serial: u32, surface: Proxy, hotspot_x: i32, hotspot_y: i32) {
	args := [4]Argument{{u = serial}, {o = rawptr(surface)}, {i = hotspot_x}, {i = hotspot_y}}
	marshal(p, 0, nil, 0, 0, &args[0])
}

// release — release the pointer object (since v3) [destructor]
wl_pointer_release :: proc "contextless" (p: Proxy) {
	if proxy_version(p) < 3 do return
	marshal(p, 1, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// Wl_Pointer_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_pointer_listener_noop().
Wl_Pointer_Listener :: struct {
	// enter event
	enter: proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy, surface_x: Fixed, surface_y: Fixed),
	// leave event
	leave: proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy),
	// pointer motion event
	motion: proc "c" (data: rawptr, p: Proxy, time: u32, surface_x: Fixed, surface_y: Fixed),
	// pointer button event
	button: proc "c" (data: rawptr, p: Proxy, serial: u32, time: u32, button: u32, state: Wl_Pointer_Button_State),
	// axis event
	axis: proc "c" (data: rawptr, p: Proxy, time: u32, axis: Wl_Pointer_Axis, value: Fixed),
	// end of a pointer event sequence
	frame: proc "c" (data: rawptr, p: Proxy),
	// axis source event
	axis_source: proc "c" (data: rawptr, p: Proxy, axis_source: Wl_Pointer_Axis_Source),
	// axis stop event
	axis_stop: proc "c" (data: rawptr, p: Proxy, time: u32, axis: Wl_Pointer_Axis),
	// axis click event
	axis_discrete: proc "c" (data: rawptr, p: Proxy, axis: Wl_Pointer_Axis, discrete: i32),
	// axis high-resolution scroll event
	axis_value120: proc "c" (data: rawptr, p: Proxy, axis: Wl_Pointer_Axis, value120: i32),
	// axis relative physical direction event
	axis_relative_direction: proc "c" (data: rawptr, p: Proxy, axis: Wl_Pointer_Axis, direction: Wl_Pointer_Axis_Relative_Direction),
}

wl_pointer_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Pointer_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_pointer_listener_noop :: proc "contextless" () -> Wl_Pointer_Listener {
	return {
		enter = proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy, surface_x: Fixed, surface_y: Fixed) {},
		leave = proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy) {},
		motion = proc "c" (data: rawptr, p: Proxy, time: u32, surface_x: Fixed, surface_y: Fixed) {},
		button = proc "c" (data: rawptr, p: Proxy, serial: u32, time: u32, button: u32, state: Wl_Pointer_Button_State) {},
		axis = proc "c" (data: rawptr, p: Proxy, time: u32, axis: Wl_Pointer_Axis, value: Fixed) {},
		frame = proc "c" (data: rawptr, p: Proxy) {},
		axis_source = proc "c" (data: rawptr, p: Proxy, axis_source: Wl_Pointer_Axis_Source) {},
		axis_stop = proc "c" (data: rawptr, p: Proxy, time: u32, axis: Wl_Pointer_Axis) {},
		axis_discrete = proc "c" (data: rawptr, p: Proxy, axis: Wl_Pointer_Axis, discrete: i32) {},
		axis_value120 = proc "c" (data: rawptr, p: Proxy, axis: Wl_Pointer_Axis, value120: i32) {},
		axis_relative_direction = proc "c" (data: rawptr, p: Proxy, axis: Wl_Pointer_Axis, direction: Wl_Pointer_Axis_Relative_Direction) {},
	}
}

// ----------------------------------------------------------------------------
// wl_keyboard
// keyboard input device

WL_KEYBOARD_VERSION :: 9
wl_keyboard_interface: Interface

// keyboard mapping format
Wl_Keyboard_Keymap_Format :: enum u32 {
	No_Keymap = 0, // no keymap; client must understand how to interpret the raw keycode
	Xkb_V1 = 1, // libxkbcommon compatible, null-terminated string; to determine the xkb keycode, clients must add 8 to the key event keycode
}

// physical key state
Wl_Keyboard_Key_State :: enum u32 {
	Released = 0, // key is not pressed
	Pressed = 1, // key is pressed
}

// release — release the keyboard object (since v3) [destructor]
wl_keyboard_release :: proc "contextless" (p: Proxy) {
	if proxy_version(p) < 3 do return
	marshal(p, 0, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// Wl_Keyboard_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_keyboard_listener_noop().
Wl_Keyboard_Listener :: struct {
	// keyboard mapping
	keymap: proc "c" (data: rawptr, p: Proxy, format: Wl_Keyboard_Keymap_Format, fd: i32, size: u32),
	// enter event
	enter: proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy, keys: ^Array),
	// leave event
	leave: proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy),
	// key event
	key: proc "c" (data: rawptr, p: Proxy, serial: u32, time: u32, key: u32, state: Wl_Keyboard_Key_State),
	// modifier and group state
	modifiers: proc "c" (data: rawptr, p: Proxy, serial: u32, mods_depressed: u32, mods_latched: u32, mods_locked: u32, group: u32),
	// repeat rate and delay
	repeat_info: proc "c" (data: rawptr, p: Proxy, rate: i32, delay: i32),
}

wl_keyboard_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Keyboard_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_keyboard_listener_noop :: proc "contextless" () -> Wl_Keyboard_Listener {
	return {
		keymap = proc "c" (data: rawptr, p: Proxy, format: Wl_Keyboard_Keymap_Format, fd: i32, size: u32) {},
		enter = proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy, keys: ^Array) {},
		leave = proc "c" (data: rawptr, p: Proxy, serial: u32, surface: Proxy) {},
		key = proc "c" (data: rawptr, p: Proxy, serial: u32, time: u32, key: u32, state: Wl_Keyboard_Key_State) {},
		modifiers = proc "c" (data: rawptr, p: Proxy, serial: u32, mods_depressed: u32, mods_latched: u32, mods_locked: u32, group: u32) {},
		repeat_info = proc "c" (data: rawptr, p: Proxy, rate: i32, delay: i32) {},
	}
}

// ----------------------------------------------------------------------------
// wl_touch
// touchscreen input device

WL_TOUCH_VERSION :: 9
wl_touch_interface: Interface

// release — release the touch object (since v3) [destructor]
wl_touch_release :: proc "contextless" (p: Proxy) {
	if proxy_version(p) < 3 do return
	marshal(p, 0, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// Wl_Touch_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_touch_listener_noop().
Wl_Touch_Listener :: struct {
	// touch down event and beginning of a touch sequence
	down: proc "c" (data: rawptr, p: Proxy, serial: u32, time: u32, surface: Proxy, id: i32, x: Fixed, y: Fixed),
	// end of a touch event sequence
	up: proc "c" (data: rawptr, p: Proxy, serial: u32, time: u32, id: i32),
	// update of touch point coordinates
	motion: proc "c" (data: rawptr, p: Proxy, time: u32, id: i32, x: Fixed, y: Fixed),
	// end of touch frame event
	frame: proc "c" (data: rawptr, p: Proxy),
	// touch session cancelled
	cancel: proc "c" (data: rawptr, p: Proxy),
	// update shape of touch point
	shape: proc "c" (data: rawptr, p: Proxy, id: i32, major: Fixed, minor: Fixed),
	// update orientation of touch point
	orientation: proc "c" (data: rawptr, p: Proxy, id: i32, orientation: Fixed),
}

wl_touch_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Touch_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_touch_listener_noop :: proc "contextless" () -> Wl_Touch_Listener {
	return {
		down = proc "c" (data: rawptr, p: Proxy, serial: u32, time: u32, surface: Proxy, id: i32, x: Fixed, y: Fixed) {},
		up = proc "c" (data: rawptr, p: Proxy, serial: u32, time: u32, id: i32) {},
		motion = proc "c" (data: rawptr, p: Proxy, time: u32, id: i32, x: Fixed, y: Fixed) {},
		frame = proc "c" (data: rawptr, p: Proxy) {},
		cancel = proc "c" (data: rawptr, p: Proxy) {},
		shape = proc "c" (data: rawptr, p: Proxy, id: i32, major: Fixed, minor: Fixed) {},
		orientation = proc "c" (data: rawptr, p: Proxy, id: i32, orientation: Fixed) {},
	}
}

// ----------------------------------------------------------------------------
// wl_output
// compositor output region

WL_OUTPUT_VERSION :: 4
wl_output_interface: Interface

// subpixel geometry information
Wl_Output_Subpixel :: enum u32 {
	Unknown = 0, // unknown geometry
	None = 1, // no geometry
	Horizontal_Rgb = 2, // horizontal RGB
	Horizontal_Bgr = 3, // horizontal BGR
	Vertical_Rgb = 4, // vertical RGB
	Vertical_Bgr = 5, // vertical BGR
}

// transformation applied to buffer contents
Wl_Output_Transform :: enum u32 {
	Normal = 0, // no transform
	_90 = 1, // 90 degrees counter-clockwise
	_180 = 2, // 180 degrees counter-clockwise
	_270 = 3, // 270 degrees counter-clockwise
	Flipped = 4, // 180 degree flip around a vertical axis
	Flipped_90 = 5, // flip and rotate 90 degrees counter-clockwise
	Flipped_180 = 6, // flip and rotate 180 degrees counter-clockwise
	Flipped_270 = 7, // flip and rotate 270 degrees counter-clockwise
}

// mode information
Wl_Output_Mode :: distinct u32
WL_OUTPUT_MODE_CURRENT :: Wl_Output_Mode(1) // indicates this is the current mode
WL_OUTPUT_MODE_PREFERRED :: Wl_Output_Mode(2) // indicates this is the preferred mode

// release — release the output object (since v3) [destructor]
wl_output_release :: proc "contextless" (p: Proxy) {
	if proxy_version(p) < 3 do return
	marshal(p, 0, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// Wl_Output_Listener has one proc per event, in opcode order. Every slot must be
// non-nil (libwayland aborts otherwise) — start from wl_output_listener_noop().
Wl_Output_Listener :: struct {
	// properties of the output
	geometry: proc "c" (data: rawptr, p: Proxy, x: i32, y: i32, physical_width: i32, physical_height: i32, subpixel: Wl_Output_Subpixel, make: cstring, model: cstring, transform: Wl_Output_Transform),
	// advertise available modes for the output
	mode: proc "c" (data: rawptr, p: Proxy, flags: Wl_Output_Mode, width: i32, height: i32, refresh: i32),
	// sent all information about output
	done: proc "c" (data: rawptr, p: Proxy),
	// output scaling properties
	scale: proc "c" (data: rawptr, p: Proxy, factor: i32),
	// name of this output
	name: proc "c" (data: rawptr, p: Proxy, name: cstring),
	// human-readable description of this output
	description: proc "c" (data: rawptr, p: Proxy, description: cstring),
}

wl_output_add_listener :: proc "contextless" (p: Proxy, l: ^Wl_Output_Listener, data: rawptr) -> bool { return add_listener(p, l, data) }

wl_output_listener_noop :: proc "contextless" () -> Wl_Output_Listener {
	return {
		geometry = proc "c" (data: rawptr, p: Proxy, x: i32, y: i32, physical_width: i32, physical_height: i32, subpixel: Wl_Output_Subpixel, make: cstring, model: cstring, transform: Wl_Output_Transform) {},
		mode = proc "c" (data: rawptr, p: Proxy, flags: Wl_Output_Mode, width: i32, height: i32, refresh: i32) {},
		done = proc "c" (data: rawptr, p: Proxy) {},
		scale = proc "c" (data: rawptr, p: Proxy, factor: i32) {},
		name = proc "c" (data: rawptr, p: Proxy, name: cstring) {},
		description = proc "c" (data: rawptr, p: Proxy, description: cstring) {},
	}
}

// ----------------------------------------------------------------------------
// wl_region
// region interface

WL_REGION_VERSION :: 1
wl_region_interface: Interface

// destroy — destroy region [destructor]
wl_region_destroy :: proc "contextless" (p: Proxy) {
	marshal(p, 0, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// add — add rectangle to region
wl_region_add :: proc "contextless" (p: Proxy, x: i32, y: i32, width: i32, height: i32) {
	args := [4]Argument{{i = x}, {i = y}, {i = width}, {i = height}}
	marshal(p, 1, nil, 0, 0, &args[0])
}

// subtract — subtract rectangle from region
wl_region_subtract :: proc "contextless" (p: Proxy, x: i32, y: i32, width: i32, height: i32) {
	args := [4]Argument{{i = x}, {i = y}, {i = width}, {i = height}}
	marshal(p, 2, nil, 0, 0, &args[0])
}

// ----------------------------------------------------------------------------
// wl_subcompositor
// sub-surface compositing

WL_SUBCOMPOSITOR_VERSION :: 1
wl_subcompositor_interface: Interface

Wl_Subcompositor_Error :: enum u32 {
	Bad_Surface = 0, // the to-be sub-surface is invalid
	Bad_Parent = 1, // the to-be sub-surface parent is invalid
}

// destroy — unbind from the subcompositor interface [destructor]
wl_subcompositor_destroy :: proc "contextless" (p: Proxy) {
	marshal(p, 0, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// get_subsurface — give a surface the role sub-surface
wl_subcompositor_get_subsurface :: proc "contextless" (p: Proxy, surface: Proxy, parent: Proxy) -> Proxy {
	args := [3]Argument{{o = nil}, {o = rawptr(surface)}, {o = rawptr(parent)}}
	return marshal(p, 1, &wl_subsurface_interface, proxy_version(p), 0, &args[0])
}

// ----------------------------------------------------------------------------
// wl_subsurface
// sub-surface interface to a wl_surface

WL_SUBSURFACE_VERSION :: 1
wl_subsurface_interface: Interface

Wl_Subsurface_Error :: enum u32 {
	Bad_Surface = 0, // wl_surface is not a sibling or the parent
}

// destroy — remove sub-surface interface [destructor]
wl_subsurface_destroy :: proc "contextless" (p: Proxy) {
	marshal(p, 0, nil, 0, MARSHAL_FLAG_DESTROY, nil)
}

// set_position — reposition the sub-surface
wl_subsurface_set_position :: proc "contextless" (p: Proxy, x: i32, y: i32) {
	args := [2]Argument{{i = x}, {i = y}}
	marshal(p, 1, nil, 0, 0, &args[0])
}

// place_above — restack the sub-surface
wl_subsurface_place_above :: proc "contextless" (p: Proxy, sibling: Proxy) {
	args := [1]Argument{{o = rawptr(sibling)}}
	marshal(p, 2, nil, 0, 0, &args[0])
}

// place_below — restack the sub-surface
wl_subsurface_place_below :: proc "contextless" (p: Proxy, sibling: Proxy) {
	args := [1]Argument{{o = rawptr(sibling)}}
	marshal(p, 3, nil, 0, 0, &args[0])
}

// set_sync — set sub-surface to synchronized mode
wl_subsurface_set_sync :: proc "contextless" (p: Proxy) {
	marshal(p, 4, nil, 0, 0, nil)
}

// set_desync — set sub-surface to desynchronized mode
wl_subsurface_set_desync :: proc "contextless" (p: Proxy) {
	marshal(p, 5, nil, 0, 0, nil)
}

