	t[83] = &wl_surface_interface // wl_keyboard.leave
	t[86] = &wl_surface_interface // wl_touch.down
	t[90] = &wl_subsurface_interface // wl_subcompositor.get_subsurface
	t[91] = &wl_surface_interface // wl_subcompositor.get_subsurface
	t[92] = &wl_surface_interface // wl_subcompositor.get_subsurface
	t[93] = &wl_surface_interface // wl_subsurface.place_above
	t[94] = &wl_surface_interface // wl_subsurface.place_below
	wl_display_requests = {
		{"sync", "n", &t[8]},
		{"get_registry", "n", &t[9]},
	}
	wl_display_events = {
		{"error", "ous", &t[0]},
		{"delete_id", "u", &t[0]},
	}
	wl_display_interface = {"wl_display", 1, 2, &wl_display_requests[0], 2, &wl_display_events[0]}
	wl_registry_requests = {
		{"bind", "usun", &t[0]},
	}
	wl_registry_events = {
		{"global", "usu", &t[0]},
		{"global_remove", "u", &t[0]},
	}
	wl_registry_interface = {"wl_registry", 1, 1, &wl_registry_requests[0], 2, &wl_registry_events[0]}
	wl_callback_events = {
		{"done", "u", &t[0]},
	}
	wl_callback_interface = {"wl_callback", 1, 0, nil, 1, &wl_callback_events[0]}
	wl_compositor_requests = {
		{"create_surface", "n", &t[10]},
		{"create_region", "n", &t[11]},
