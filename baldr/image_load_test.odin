@(private = "file")
IMG_BMP :: [?]u8{0x42, 0x4d, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x36, 0x00, 0x00, 0x00, 0x28, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x01, 0x00, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x30, 0x00, 0x00, 0x00, 0xc4, 0x0e, 0x00, 0x00, 0xc4, 0x0e, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8}
@(private = "file")
IMG_TGA :: [?]u8{0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x04, 0x00, 0x18, 0x00, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x1e, 0x1e, 0xc8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x54, 0x52, 0x55, 0x45, 0x56, 0x49, 0x53, 0x49, 0x4f, 0x4e, 0x2d, 0x58, 0x46, 0x49, 0x4c, 0x45, 0x2e, 0x00}
@(private = "file")
IMG_PPM :: "P3\n2 2\n255\n200 30 30  200 30 30\n200 30 30  200 30 30\n"

@(private = "file")
IMG_SVG :: "<?xml version=\"1.0\"?>\n<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"4\" height=\"4\"><rect width=\"4\" height=\"4\" fill=\"#c81e1e\"/></svg>"

@(private = "file")
load_reddish :: proc(t: ^testing.T, what: string, data: []u8, w, h: int) {
	img, ok := image_load(data)
	defer if ok do image_destroy(&img)
	if !testing.expectf(t, ok, "%s decodes", what) do return
	testing.expectf(t, img.width == w && img.height == h, "%s is %dx%d, got %dx%d", what, w, h, img.width, img.height)
	r, g, a := img.pixels[0], img.pixels[1], img.pixels[3]
	testing.expectf(t, r > 150 && g < 90 && a == 255, "%s's first pixel is the red it was saved as: %v", what, img.pixels[:4])
}

@(test)
image_load_reads_each_format_from_its_bytes :: proc(t: ^testing.T) {
	jpeg, bmp, tga := IMG_JPEG, IMG_BMP, IMG_TGA
	load_reddish(t, "JPEG", jpeg[:], 4, 4)
	load_reddish(t, "BMP", bmp[:], 4, 4)
	load_reddish(t, "TGA", tga[:], 4, 4)
	load_reddish(t, "netpbm", transmute([]u8)string(IMG_PPM), 2, 2)
	load_reddish(t, "SVG", transmute([]u8)string(IMG_SVG), 4, 4)
	_, ok := image_load(transmute([]u8)string("not a picture at all"))
	testing.expect(t, !ok, "unknown bytes are refused")
	_, ok = image_load(nil)
	testing.expect(t, !ok, "no bytes are refused")
}

@(test)
image_load_refuses_a_picture_cut_short :: proc(t: ^testing.T) {
	jpeg, bmp, tga := IMG_JPEG, IMG_BMP, IMG_TGA
	files := [][]u8{jpeg[:], bmp[:], tga[:], transmute([]u8)string(IMG_PPM), transmute([]u8)string(IMG_SVG)}
	for f in files {
		for n in 0 ..< len(f) {
			img, ok := image_load(f[:n])
			if ok do image_destroy(&img) // a prefix may still be a whole picture (a TGA's footer is optional)
		}
	}
}

// A picture's header can claim any size: a few bytes that say 60,000 by
// 60,000 must be refused before a decoder allocates gigabytes for them.
@(test)
image_load_refuses_a_picture_that_claims_to_be_huge :: proc(t: ^testing.T) {
	be32 :: proc(b: []u8, at: int, v: u32) { b[at], b[at + 1], b[at + 2], b[at + 3] = u8(v >> 24), u8(v >> 16), u8(v >> 8), u8(v) }
	le16 :: proc(b: []u8, at: int, v: u16) { b[at], b[at + 1] = u8(v), u8(v >> 8) }
	png := make([]u8, 64, context.temp_allocator)
	copy(png, "\x89PNG\r\n\x1a\n\x00\x00\x00\x0dIHDR")
	be32(png, 16, 60000); be32(png, 20, 60000); png[24] = 8; png[25] = 6
	qoi := make([]u8, 32, context.temp_allocator)
	copy(qoi, "qoif"); be32(qoi, 4, 60000); be32(qoi, 8, 60000); qoi[12] = 4
	bmp := make([]u8, 64, context.temp_allocator)
	copy(bmp, "BM"); bmp[14] = 40; le16(bmp, 18, 60000); le16(bmp, 22, 60000); bmp[28] = 32
	jpeg := make([]u8, 64, context.temp_allocator)
	copy(jpeg, "\xff\xd8\xff\xc0\x00\x11\x08"); jpeg[7], jpeg[8] = 0xEA, 0x60; jpeg[9], jpeg[10] = 0xEA, 0x60 // height then width: 60000
	pnm := transmute([]u8)string("P6\n# a comment\n60000 60000\n255\n")
	tga := make([]u8, 44, context.temp_allocator)
	tga[2] = 2; le16(tga, 12, 65535); le16(tga, 14, 65535); tga[16] = 32
	copy(tga[26:], "TRUEVISION-XFILE.\x00")
	for f, i in ([][]u8{png, qoi, bmp, jpeg, pnm, tga}) {
		start := time.tick_now()
		img, ok := image_load(f)
		if ok do image_destroy(&img)
		testing.expectf(t, !ok, "file %d claiming to be huge was refused", i)
		testing.expectf(t, time.duration_milliseconds(time.tick_since(start)) < 200, "file %d was refused at once", i)
	}

	// an XPM's rows are text, so a short file claiming a big picture is
	// refused before the picture is allocated
	xb := strings.builder_make(context.temp_allocator)
	strings.write_string(&xb, `"16384 16384 1 1", "a c #000000"`)
	for _ in 0 ..< 16384 do strings.write_string(&xb, `, ""`)
	xstart := time.tick_now()
	ximg, xok := image_load_xpm(transmute([]u8)strings.to_string(xb))
	if xok do image_destroy(&ximg)
	testing.expect(t, !xok, "an XPM claiming 16384 square with empty rows was refused")
	testing.expect(t, time.duration_milliseconds(time.tick_since(xstart)) < 200, "at once")

	// a real one still loads, and the budget can be set either way
	bmp4 := IMG_BMP
	small, sok := image_load(bmp4[:], max_pixels = 16)
	testing.expect(t, sok, "a 4 by 4 picture fits a budget of 16 pixels")
	if sok do image_destroy(&small)
	_, tight := image_load(bmp4[:], max_pixels = 15)
	testing.expect(t, !tight, "and not a budget of 15")
}

// An SVG whose `use` elements each repeat the level before grows tenfold a
// level: eight levels is a hundred million shapes from a few kilobytes. It is
// drawn as far as a budget allows, at once, rather than holding the app.
@(test)
image_load_draws_an_svg_use_bomb_within_a_budget :: proc(t: ^testing.T) {
	b := strings.builder_make(context.temp_allocator)
	strings.write_string(&b, `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="16" height="16"><defs><g id="g0"><rect width="1" height="1"/></g>`)
	for l in 1 ..= 8 {
		strings.write_string(&b, `<g id="g`); strings.write_int(&b, l); strings.write_string(&b, `">`)
		for _ in 0 ..< 10 {
			strings.write_string(&b, `<use xlink:href="#g`); strings.write_int(&b, l - 1); strings.write_string(&b, `"/>`)
		}
		strings.write_string(&b, `</g>`)
	}
	strings.write_string(&b, `</defs><use xlink:href="#g8"/></svg>`)
	start := time.tick_now()
	img, ok := image_load(transmute([]u8)strings.to_string(b))
	if ok do image_destroy(&img)
	ms := time.duration_milliseconds(time.tick_since(start))
	testing.expectf(t, ms < 2000, "a hundred million uses end within the budget: %.0f ms", ms)
}

// A phone held upright saves its photo on its side and records how to turn
// it. Each of the eight orientations comes out as Pillow's exif_transpose
// turns it: the colour at the centre of each quadrant, and the sides.
@(test)
a_photo_is_turned_the_way_its_camera_recorded :: proc(t: ^testing.T) {
	R, G, B, W :: [3]u8{220, 30, 30}, [3]u8{30, 200, 30}, [3]u8{30, 30, 220}, [3]u8{240, 240, 240}
	Case :: struct { file: []u8, w, h: int, quad: [4][3]u8 } // top left, top right, bottom left, bottom right
	cases := [8]Case{
		{#load("../assets/test/exif/o1.jpg"), 24, 12, {R, G, B, W}},
		{#load("../assets/test/exif/o2.jpg"), 24, 12, {G, R, W, B}},
		{#load("../assets/test/exif/o3.jpg"), 24, 12, {W, B, G, R}},
		{#load("../assets/test/exif/o4.jpg"), 24, 12, {B, W, R, G}},
		{#load("../assets/test/exif/o5.jpg"), 12, 24, {R, B, G, W}},
		{#load("../assets/test/exif/o6.jpg"), 12, 24, {B, R, W, G}},
		{#load("../assets/test/exif/o7.jpg"), 12, 24, {W, G, B, R}},
		{#load("../assets/test/exif/o8.jpg"), 12, 24, {G, W, R, B}},
	}
	for c, i in cases {
		img, ok := image_load(c.file)
		if !testing.expectf(t, ok, "orientation %d loads", i + 1) do continue
		defer image_destroy(&img)
		testing.expectf(t, img.width == c.w && img.height == c.h, "orientation %d is %dx%d: got %dx%d", i + 1, c.w, c.h, img.width, img.height)
		if img.width != c.w || img.height != c.h do continue
		for q, k in c.quad {
			x := ((k % 2) * 2 + 1) * c.w / 4
			y := ((k / 2) * 2 + 1) * c.h / 4
			p := img.pixels[(y * c.w + x) * 4:]
			near := abs(int(p[0]) - int(q[0])) < 40 && abs(int(p[1]) - int(q[1])) < 40 && abs(int(p[2]) - int(q[2])) < 40
			testing.expectf(t, near, "orientation %d, quadrant %d: %v, wanted about %v", i + 1, k, p[:3], q)
		}
	}
}

} // when ODIN_TEST
