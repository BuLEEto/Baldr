// api_gen writes docs/API.md: every public declaration of package baldr
// with its signature and the comment above it, grouped by file. Run it
// after an API change (./build.sh api); diff the result before a release
// to see what changed for users.
//
//   odin run tools/api_gen -- baldr docs/API.md
package main

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:slice"
import "core:strings"

Decl :: struct {
	name, kind, sig, doc: string,
}

main :: proc() {
	if len(os.args) < 3 {
		fmt.eprintln("usage: api_gen <package dir> <out.md>")
		os.exit(2)
	}
	dir, out_path := os.args[1], os.args[2]
	entries, err := os.read_all_directory_by_path(dir, context.allocator)
	if err != nil {
		fmt.eprintln("api_gen: cannot read", dir)
		os.exit(1)
	}
	files := make([dynamic]string)
	for e in entries {
		if strings.has_suffix(e.name, ".odin") && !strings.has_suffix(e.name, "_test.odin") && !strings.has_suffix(e.name, "_data.odin") do append(&files, e.name)
	}
	slice.sort(files[:])
	// The app-facing files first: these in reading order, then every other
	// file not named below. `machinery` is the package's own workings, public
	// in Odin's sense and not part of the promise. A file is app-facing
	// unless it is listed there, so a new file is never hidden by accident.
	front := []string{"app.odin", "build.odin", "surface.odin", "theme.odin", "theme_style.odin", "document.odin", "markdown.odin", "language.odin",
		"widget_text_input.odin", "widget_text_area.odin", "widget_code.odin", "widget_rich.odin", "widget_controls.odin", "widget_choice.odin",
		"widget_number.odin", "widget_date.odin", "widget_time.odin", "widget_color.odin", "widget_chip.odin", "widget_expander.odin",
		"widget_feedback.odin", "widget_toast.odin", "widget_breadcrumbs.odin", "widget_tabs.odin", "widget_list.odin", "widget_table.odin",
		"widget_icon_view.odin", "widget_tree.odin", "widget_split.odin", "widget_grid.odin", "widget_menu_bar.odin", "overlay.odin",
		"image.odin", "widget_icon.odin", "widget_custom.odin", "canvas.odin", "job.odin", "sched.odin", "shortcut.odin", "clipboard.odin",
		"file_io.odin", "dnd.odin", "notify.odin", "tray.odin", "desktop.odin", "secret.odin"}
	machinery := []string{"a11y_atspi.odin", "a11y_changes.odin", "a11y_cocoa.odin", "a11y_events.odin", "a11y_model.odin",
		"a11y_test_support.odin", "a11y_uia.odin", "app_darwin.odin", "app_linux.odin", "app_windows.odin", "drag_picture.odin",
		"font_cache.odin", "font_sfnt.odin", "glibc_linux.odin", "gpu_reset.odin", "ime.odin", "inotify_test_linux.odin",
		"instance_posix.odin", "instance_windows.odin", "memory_watch.odin", "png_check.odin", "popup.odin", "secret_darwin.odin",
		"secret_linux.odin", "secret_other.odin", "secret_windows.odin", "selection_paint.odin", "svg_draw.odin", "svg_paint.odin",
		"svg_text.odin", "terminal_draw.odin", "terminal_glyphs.odin", "text_fallback.odin", "touch.odin", "unicode_ranges.odin"}
	for f in front do if !slice.contains(files[:], f) {
		fmt.eprintfln("api_gen: %s is listed as app-facing and does not exist; update the list", f)
		os.exit(1)
	}
	for f in machinery do if !slice.contains(files[:], f) {
		fmt.eprintfln("api_gen: %s is listed as machinery and does not exist; update the list", f)
		os.exit(1)
	}
	ordered := make([dynamic]string)
	append(&ordered, ..front)
	for f in files do if !slice.contains(front, f) && !slice.contains(machinery, f) do append(&ordered, f)
	rest_at := len(ordered)
	for f in files do if slice.contains(machinery, f) do append(&ordered, f)
	b := strings.builder_make()
	fmt.sbprintln(&b, "# Baldr API")
	fmt.sbprintln(&b, "")
	fmt.sbprintln(&b, "Generated by `./build.sh api` from the doc comments in `baldr/`; edit the comments, not this file. The first part is what apps call, in reading order. The internals at the end are public only because Odin has no finer privacy — from RC1 the first part does not break.")
	total := 0
	Demoted :: struct { file: string, decls: [dynamic]Decl }
	demoted := make([dynamic]Demoted)
	for f, fi in ordered {
		if fi == rest_at {
			fmt.sbprintln(&b, "\n---\n\n# Internals")
			// the machinery that sat in app-facing files, moved out of the
			// section whose header promises "what apps call"
			for dm in demoted {
				fmt.sbprintfln(&b, "\n## %s", dm.file)
				for d in dm.decls {
					total += 1
					fmt.sbprintfln(&b, "\n### `%s`", d.name)
					fmt.sbprintfln(&b, "\n%s", d.kind)
				}
			}
		}
		path, _ := filepath.join({dir, f})
		data, rerr := os.read_entire_file_from_path(path, context.allocator)
		if rerr != nil do continue
		decls, file_doc := scan(string(data))
		if len(decls) == 0 do continue
		fmt.sbprintfln(&b, "\n## %s", f)
		// The widget's own prose: the block at the top of the file, above the
		// imports, describing the builder the file is named after.
		if len(file_doc) > 0 do fmt.sbprintfln(&b, "\n%s", file_doc)
		front_file := fi < rest_at
		keep := make([dynamic]Decl, context.temp_allocator)
		hold: [dynamic]Decl
		for d in decls {
			if front_file && internal_shaped(d) {
				append(&hold, d)
			} else {
				append(&keep, d)
			}
		}
		if len(hold) > 0 do append(&demoted, Demoted{file = f, decls = hold})
		if len(keep) == 0 do continue
		for d in keep {
			total += 1
			fmt.sbprintfln(&b, "\n### `%s`", d.name)
			if d.sig != "" {
				fmt.sbprintfln(&b, "\n```odin\n%s\n```", d.sig)
			} else {
				fmt.sbprintfln(&b, "\n%s", d.kind)
			}
			if len(d.doc) > 0 do fmt.sbprintfln(&b, "\n%s", d.doc)
		}
	}
	if werr := os.write_entire_file(out_path, transmute([]u8)strings.to_string(b)); werr != nil {
		fmt.eprintln("api_gen: cannot write", out_path, werr)
		os.exit(1)
	}
	fmt.printfln("api_gen: %d declarations → %s", total, out_path)
}

// internal_shaped answers whether a declaration in an app-facing file is
// really the file's own machinery rather than part of the promise: a widget's
// retained state struct, or a tuning constant. Procs are never demoted, and
// **anything with a doc comment stays**, so documenting one is how it moves
// back up. Without this, `Table_State` and `TABLE_KEY_RESIZE_STEP` would sit
// undescribed in the section whose header says "what apps call".
internal_shaped :: proc(d: Decl) -> bool {
	if d.kind == "proc" do return false
	if len(d.doc) > 0 do return false
	if strings.has_suffix(d.name, "_State") do return true
	screaming := true
	for r in d.name do if !(r >= 'A' && r <= 'Z') && !(r >= '0' && r <= '9') && r != '_' do screaming = false
	return screaming
}

// scan finds top-level `name :: …` declarations with the comment block
// directly above them, skipping @(private) ones. `file_doc` is the block at
// the top of the file that belongs to no declaration — the widget's own
// description, which in most widget files sits above the imports.
scan :: proc(src: string) -> (decls: []Decl, file_doc: string) {
	out := make([dynamic]Decl)
	lines := strings.split_lines(src)
	comment := make([dynamic]string)
	private := false
	i := 0
	for i < len(lines) {
		line := lines[i]
		switch {
		case strings.has_prefix(line, "//"):
			append(&comment, strings.trim_right_space(line[2:])) // leading indent kept: an example is a code block
			i += 1
			continue
		case strings.has_prefix(line, "@(private"):
			private = true
			i += 1
			continue
		case len(line) == 0 || line[0] == ' ' || line[0] == '\t' || strings.has_prefix(line, "package") || strings.has_prefix(line, "import"):
			if len(strings.trim_space(line)) == 0 || strings.has_prefix(line, "package") || strings.has_prefix(line, "import") {
				drop(&comment, len(out), &file_doc)
				private = false
			}
			i += 1
			continue
		}
		// a top-level declaration?
		sep := strings.index(line, " :: ")
		if sep <= 0 || private {
			private = false
			drop(&comment, len(out), &file_doc) // a `#+build` line, a closing brace
			i += 1
			continue
		}
		name := line[:sep]
		rest := line[sep + 4:]
		if strings.contains(name, " ") || strings.has_prefix(name, "_") {
			clear(&comment)
			i += 1
			continue
		}
		kind := "value"
		sig := ""
		switch {
		case strings.has_prefix(rest, "proc"):
			kind = "proc"
			// Collect until the body opens — or, for a proc *type*, which has
			// no body (`Row_Key :: proc(user: rawptr, index: int) -> u64`),
			// until its parameter list closes; without that stop the loop
			// swallows the declarations that follow (`i = j`).
			//
			// The body is the `{` that comes once the parameters have closed,
			// not the first `{` on a line: a default written as a literal
			// (`bg: Color = {}`) would cut the signature short.
			sb := strings.builder_make()
			j, depth, opened := i, 0, false
			if strings.has_prefix(strings.trim_left_space(rest[len("proc"):]), "{") {
				// a proc group, `secret_scrub :: proc{secret_scrub_value, …}`:
				// no parameters to wait for, and the braces are the whole of it
				strings.write_string(&sb, strings.trim_right_space(line))
				j = len(lines) // read: the loop below has nothing to do
			}
			for j < len(lines) {
				l := lines[j]
				if j > i do strings.write_string(&sb, "\n")
				body := signature_body(l, &depth, &opened)
				if body >= 0 {
					strings.write_string(&sb, strings.trim_right_space(l[:body]))
					break
				}
				strings.write_string(&sb, strings.trim_right_space(l))
				if opened && depth <= 0 do break // closed with no body: a proc type
				j += 1
				if j - i > 16 do break
			}
			sig = strings.to_string(sb)
			if j < len(lines) do i = j // a group stays on its own line
		case strings.has_prefix(rest, "struct"): kind = "struct"
		case strings.has_prefix(rest, "enum"):   kind = "enum"
		case strings.has_prefix(rest, "union"):  kind = "union"
		case strings.has_prefix(rest, "distinct"): kind = "distinct type"
		case strings.has_prefix(rest, "#type"):  kind = "proc type"
		case strings.has_prefix(rest, "bit_set"): kind = "bit_set"
		case strings.has_prefix(rest, "[") || strings.has_prefix(rest, "map"): kind = "value"
		case:
			kind = "constant"
		}
		// A type's source is its contract as much as a proc's signature is:
		// an app fills in `App`, `Theme` and `Surface_Desc` field by field
		// and picks `Button_Variant`'s values by name. So a struct shows its
		// fields with their comments, an enum its values, a constant its
		// value — except the runtime's own state (machinery), whose fields an
		// app never touches.
		if kind != "proc" {
			body, end := declaration_body(lines, i)
			if !(kind == "struct" && machinery(name)) && (kind != "constant" && kind != "value" || end - i < DECL_BODY_MAX) do sig = body
			i = end - 1 // the loop's own step lands on the line after the body, which may be the next declaration's comment
		}
		flat := make([dynamic]string, 0, len(comment))
		for l in comment do append(&flat, strings.trim_space(l))
		doc := strings.join(flat[:], " ") // the comment as written, one paragraph
		append(&out, Decl{name = name, kind = kind, sig = sig, doc = doc})
		clear(&comment)
		private = false
		i += 1
	}
	drop(&comment, len(out), &file_doc)
	return out[:], file_doc
}

// drop lets go of a pending comment block, keeping it as the file's own doc
// if it is the first block in the file and no declaration has claimed it.
// A bare `//` line is a paragraph break, so a long description reads as the
// paragraphs it was written in rather than one run-on line.
@(private = "file")
drop :: proc(comment: ^[dynamic]string, decls_so_far: int, file_doc: ^string) {
	defer clear(comment)
	if decls_so_far > 0 || len(file_doc^) > 0 || len(comment) == 0 do return
	b := strings.builder_make()
	gap := false  // a paragraph break is pending
	fence := false // inside a code block
	for line in comment {
		text := strings.trim_space(line)
		if len(text) == 0 {
			gap = strings.builder_len(b) > 0
			continue
		}
		// An indented line is an example, which has to stay one: run
		// together as prose, `for i in first ..< last {` reads as part of
		// the sentence above it.
		code := line[0] == '\t' || strings.has_prefix(line, "  ")
		if code && !fence {
			if strings.builder_len(b) > 0 do strings.write_string(&b, "\n\n")
			strings.write_string(&b, "```odin\n")
			fence, gap = true, false
		} else if !code && fence {
			strings.write_string(&b, "\n```\n\n")
			fence, gap = false, false
		} else if fence {
			strings.write_string(&b, "\n")
		} else if gap {
			strings.write_string(&b, "\n\n")
			gap = false
		} else if strings.builder_len(b) > 0 {
			strings.write_string(&b, " ")
		}
		strings.write_string(&b, text if !fence else strings.trim_prefix(line, "\t"))
	}
	if fence do strings.write_string(&b, "\n```")
	file_doc^ = strings.to_string(b)
}

// signature_body reads one line of a proc's declaration, keeping count of
// the parentheses it has opened, and returns where its body opens: the
// first `{` outside every parenthesis once the parameter list has opened,
// or -1. Braces inside the parameters — a default of `{}` or `{1, 2}` — and
// anything in a string or rune literal are not the body.
signature_body :: proc(l: string, depth: ^int, opened: ^bool) -> int {
	quote: u8 = 0
	for k := 0; k < len(l); k += 1 {
		c := l[k]
		if quote != 0 {
			if c == '\\' { k += 1 } else if c == quote { quote = 0 }
			continue
		}
		switch c {
		case '"', '\'': quote = c
		case '/': if k + 1 < len(l) && l[k + 1] == '/' do return -1 // the rest is a comment
		case '(': depth^ += 1; opened^ = true
		case ')': depth^ -= 1
		case '{': if opened^ && depth^ == 0 do return k
		}
	}
	return -1
}

// DECL_BODY_MAX is the longest a constant's or a table's value may be and
// still be shown: a lookup table is data, not a contract.
DECL_BODY_MAX :: 40

// machinery says whether a public struct is the runtime's own state rather
// than something an app fills in or reads: a widget's retained state
// (`*_State`), and the few big structs behind `ui` and the run loop. Their
// fields are public only because Odin has no finer privacy; listing them
// would bury `App` and `Theme` under a few hundred fields nobody should
// set. A new app-facing struct gets its fields shown by default — keeping
// it out is the choice that has to be made here.
machinery :: proc(name: string) -> bool {
	if strings.has_suffix(name, "_State") do return true
	switch name {
	case "Tree", "Ui", "Node_Data", "Frame_Ctx", "Text_Engine", "Cmd", "Mailbox", "Canvas_Host", "Pointer", "Icon_Themes":
		return true
	}
	return false
}

// declaration_body is the source of the declaration starting at `lines[i]`
// — the one line, or through the brace that closes its body — and the line
// after it. Braces in comments and in string or rune literals do not count.
declaration_body :: proc(lines: []string, i: int) -> (body: string, next: int) {
	sb := strings.builder_make()
	depth, opened := 0, false
	j := i
	for j < len(lines) {
		l := lines[j]
		if j > i do strings.write_string(&sb, "\n")
		strings.write_string(&sb, strings.trim_right_space(l))
		quote: u8 = 0
		scan: for k := 0; k < len(l); k += 1 {
			c := l[k]
			if quote != 0 {
				if c == '\\' && quote != '`' { k += 1 } else if c == quote { quote = 0 }
				continue
			}
			switch c {
			case '"', '\'', '`': quote = c
			case '/': if k + 1 < len(l) && l[k + 1] == '/' do break scan // the rest is a comment
			case '{': depth += 1; opened = true
			case '}': depth -= 1
			}
		}
		j += 1
		if !opened || depth <= 0 do break // one line, or its body closed
	}
	return strings.to_string(sb), j
}
