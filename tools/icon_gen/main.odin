// icon_gen — extracts a subset of Lucide's sprite sheet into
// baldr/icons_data.odin: every shape is converted to one SVG path string so
// the runtime only needs a path parser (svg.odin).
//
//   odin run tools/icon_gen -- third_party/lucide/sprite.svg tools/icon_gen/icons.txt baldr/icons_data.odin
package main

import "core:encoding/xml"
import "core:fmt"
import "core:os"
import "core:strconv"
import "core:strings"

main :: proc() {
	if len(os.args) < 4 {
		fmt.eprintln("usage: icon_gen <sprite.svg> <icons.txt> <out.odin>")
		os.exit(2)
	}
	doc, err := xml.load_from_file(os.args[1])
	if err != .None {
		fmt.eprintln("icon_gen: cannot parse", os.args[1], err)
		os.exit(1)
	}
	list_bytes, rerr := os.read_entire_file_from_path(os.args[2], context.allocator)
	if rerr != nil {
		fmt.eprintln("icon_gen: cannot read", os.args[2])
		os.exit(1)
	}
	// A line is a sprite id, or `our-name = their-id` where the two differ.
	// Lucide renames icons between releases — `smile` became
	// `face-slightly-smiling` — and an alias keeps our enum stable across
	// that instead of making every app that drew a smiley edit its code.
	names := make([dynamic]string) // what the enum and ICON_NAMES say
	ids := make([dynamic]string)   // …and what to look up in the sprite
	for line in strings.split_lines(string(list_bytes)) {
		l := strings.trim_space(line)
		if l == "" || strings.has_prefix(l, "#") do continue
		name, id := l, l
		if eq := strings.index_byte(l, '='); eq >= 0 {
			name = strings.trim_space(l[:eq])
			id = strings.trim_space(l[eq + 1:])
		}
		append(&names, name)
		append(&ids, id)
	}
	symbols := make(map[string]xml.Element_ID)
	for el, id in doc.elements {
		if el.kind != .Element || el.ident != "symbol" do continue
		for a in el.attribs do if a.key == "id" do symbols[a.val] = xml.Element_ID(id)
	}
	b := strings.builder_make()
	fmt.sbprintln(&b, "package baldr")
	fmt.sbprintln(&b, "")
	fmt.sbprintln(&b, "// Generated by tools/icon_gen from third_party/lucide/sprite.svg (ISC, see")
	fmt.sbprintln(&b, "// third_party/lucide/LICENSE). Do not edit: add names to tools/icon_gen/icons.txt")
	fmt.sbprintln(&b, "// and rerun. Each icon is one SVG path in a 24×24 box, stroked 2 px with round")
	fmt.sbprintln(&b, "// caps and joins; '|' separates the original shapes (each restarts at the")
	fmt.sbprintln(&b, "// origin) and a leading '#' marks a filled shape.")
	fmt.sbprintln(&b, "")
	fmt.sbprintln(&b, "Icon :: enum u16 {")
	fmt.sbprintln(&b, "\tNone,")
	for n in names do fmt.sbprintfln(&b, "\t%s,", ada_case(n))
	fmt.sbprintln(&b, "}")
	fmt.sbprintln(&b, "")
	fmt.sbprintln(&b, "ICON_NAMES := [Icon]string{")
	fmt.sbprintln(&b, "\t.None = \"\",")
	for n in names do fmt.sbprintfln(&b, "\t.%s = %q,", ada_case(n), n)
	fmt.sbprintln(&b, "}")
	fmt.sbprintln(&b, "")
	fmt.sbprintln(&b, "@(rodata)")
	fmt.sbprintln(&b, "ICON_PATHS := [Icon]string{")
	fmt.sbprintln(&b, "\t.None = \"\",")
	missing := 0
	for n, i in names {
		id, found := symbols[ids[i]]
		if !found {
			fmt.eprintln("icon_gen: no such icon:", ids[i])
			missing += 1
			continue
		}
		fmt.sbprintfln(&b, "\t.%s = %q,", ada_case(n), symbol_path(doc, id))
	}
	fmt.sbprintln(&b, "}")
	if missing > 0 do os.exit(1)
	if werr := os.write_entire_file(os.args[3], transmute([]u8)strings.to_string(b)); werr != nil {
		fmt.eprintln("icon_gen: cannot write", os.args[3], werr)
		os.exit(1)
	}
	fmt.printfln("icon_gen: %d icons → %s", len(names), os.args[3])
}

ada_case :: proc(kebab: string) -> string {
	b := strings.builder_make()
	up := true
	for r in kebab {
		if r == '-' {
			strings.write_rune(&b, '_')
			up = true
			continue
		}
		if up && r >= 'a' && r <= 'z' { strings.write_rune(&b, r - 32) } else { strings.write_rune(&b, r) }
		up = false
	}
	s := strings.to_string(b)
	if len(s) > 0 && s[0] >= '0' && s[0] <= '9' do return strings.concatenate({"N", s})
	return s
}

attr :: proc(el: ^xml.Element, key: string) -> (string, bool) {
	for a in el.attribs do if a.key == key do return a.val, true
	return "", false
}

num :: proc(el: ^xml.Element, key: string, def: f64 = 0) -> f64 {
	if v, ok := attr(el, key); ok {
		f, _ := strconv.parse_f64(v)
		return f
	}
	return def
}

// symbol_path joins a symbol's shapes into one path string. Shapes with
// fill="currentColor" are prefixed with '#'.
symbol_path :: proc(doc: ^xml.Document, id: xml.Element_ID) -> string {
	b := strings.builder_make()
	sym := &doc.elements[id]
	for v in sym.value {
		child, is_el := v.(xml.Element_ID)
		if !is_el || doc.elements[child].kind != .Element do continue
		el := &doc.elements[child]
		// '|' separates the symbol's shapes: each starts at the origin again
		// (a relative moveto at the start of a <path> is relative to 0,0).
		if strings.builder_len(b) > 0 do strings.write_string(&b, " | ")
		if f, ok := attr(el, "fill"); ok && f != "none" do strings.write_string(&b, "#")
		switch el.ident {
		case "path":
			d, _ := attr(el, "d")
			strings.write_string(&b, strings.trim_space(d))
		case "circle":
			cx, cy, r := num(el, "cx"), num(el, "cy"), num(el, "r")
			fmt.sbprintf(&b, "M%g %gA%g %g 0 1 0 %g %gA%g %g 0 1 0 %g %gZ", cx - r, cy, r, r, cx + r, cy, r, r, cx - r, cy)
		case "ellipse":
			cx, cy, rx, ry := num(el, "cx"), num(el, "cy"), num(el, "rx"), num(el, "ry")
			fmt.sbprintf(&b, "M%g %gA%g %g 0 1 0 %g %gA%g %g 0 1 0 %g %gZ", cx - rx, cy, rx, ry, cx + rx, cy, rx, ry, cx - rx, cy)
		case "rect":
			x, y, w, h := num(el, "x"), num(el, "y"), num(el, "width"), num(el, "height")
			rx := num(el, "rx")
			ry := num(el, "ry", rx)
			if rx <= 0 && ry <= 0 {
				fmt.sbprintf(&b, "M%g %gH%gV%gH%gZ", x, y, x + w, y + h, x)
			} else {
				fmt.sbprintf(&b, "M%g %gH%gA%g %g 0 0 1 %g %gV%gA%g %g 0 0 1 %g %gH%gA%g %g 0 0 1 %g %gV%gA%g %g 0 0 1 %g %gZ",
					x + rx, y, x + w - rx, rx, ry, x + w, y + ry, y + h - ry, rx, ry, x + w - rx, y + h, x + rx, rx, ry, x, y + h - ry, y + ry, rx, ry, x + rx, y)
			}
		case "line":
			fmt.sbprintf(&b, "M%g %gL%g %g", num(el, "x1"), num(el, "y1"), num(el, "x2"), num(el, "y2"))
		case "polyline", "polygon":
			pts, _ := attr(el, "points")
			fields := strings.fields(strings.trim_space(pts))
			for f, i in fields {
				xy := strings.split(f, ",")
				if len(xy) != 2 do continue
				fmt.sbprintf(&b, "%s%s %s", "M" if i == 0 else "L", xy[0], xy[1])
			}
			if el.ident == "polygon" do strings.write_string(&b, "Z")
		}
	}
	return strings.to_string(b)
}
