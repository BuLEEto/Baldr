#version 450
// a pattern written into the rectangle: x, y and a uniform level
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec4 area; float level; } pc;
void main() {
    ivec2 i = ivec2(gl_GlobalInvocationID.xy);
    if (i.x >= pc.area.z || i.y >= pc.area.w) return;
    ivec2 p = pc.area.xy + i;
    imageStore(dst, p, vec4(float(i.x) / 255.0, float(i.y) / 255.0, pc.level, 1.0));
}
